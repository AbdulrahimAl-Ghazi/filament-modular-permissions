{
    "name": "abdulrahim/filament-modular-permissions",
    "description": "Modular Roles and Permissions for Filament v5 with easy publishing and syncing.",
    "homepage": "https://abaad.dev",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Abdulrahim Al-Ghazi",
            "email": "info@abaad.dev"
        }
    ],
    "require": {
