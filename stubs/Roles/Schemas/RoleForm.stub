<?php

namespace {{namespace}}\Schemas;

use Filament\Forms\Components\TextInput;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\CheckboxList;
use Filament\Schemas\Components\Section;
use Filament\Schemas\Components\Grid;
use Filament\Schemas\Schema;
use Spatie\Permission\Models\Permission;
use Filament\Facades\Filament;
use Illuminate\Support\Str;

class RoleForm
{
    public static function configure(Schema $schema): Schema
    {
        $guard = Filament::getCurrentPanel()->getAuthGuard();
        $permissions = Permission::where('guard_name', $guard)->get();

        $groupedPermissions = $permissions->groupBy(function ($permission) {
            $resource = preg_replace('/^(view_any|view|create|update|delete_any|delete|force_delete_any|force_delete|restore_any|restore|reorder|replicate)_/', '', $permission->name);
            
            if (str_ends_with($resource, '_widget')) {
                return 'dashboard_widgets';
            }
            
            return $resource;
        });

        $sections = [];

        foreach ($groupedPermissions as $resourceName => $perms) {
            if ($resourceName === 'dashboard_widgets') {
                $translatedResource = static::translateWidget($resourceName);
                $options = [];
                foreach ($perms as $perm) {
                    $widgetName = str_replace('view_', '', $perm->name);
                    $translated = __('filament-modular-permissions::permissions.widgets.' . $widgetName);

                    if ($translated === 'filament-modular-permissions::permissions.widgets.' . $widgetName) {
                        $translated = config(
                            'filament-modular-permissions.translations.widgets.' . $widgetName,
                            Str::title(str_replace('_', ' ', $widgetName))
                        );
                    }

                    $options[$perm->name] = $translated;
                }
            } else {
                $translatedResource = static::resolveResourceLabel($resourceName);

                $options = [];
                foreach ($perms as $perm) {
                    $action = str_replace("_{$resourceName}", '', $perm->name);
                    $translatedAction = __('filament-modular-permissions::permissions.actions.' . $action);

                    if ($translatedAction === 'filament-modular-permissions::permissions.actions.' . $action) {
                        $translatedAction = config(
                            'filament-modular-permissions.translations.actions.' . $action,
                            $action
                        );
                    }

                    $options[$perm->name] = $translatedAction;
                }
            }

            $sections[] = Section::make($translatedResource)
                ->schema([
                    CheckboxList::make("permissions_{$resourceName}")
                        ->hiddenLabel()
                        ->options($options)
                        ->columns(['default' => 1, 'sm' => 2])
                        ->gridDirection('row')
                        ->bulkToggleable()
                        ->afterStateHydrated(function ($component, $record) use ($perms) {
                            if ($record) {
                                $component->state(
                                    $record->permissions->whereIn('id', $perms->pluck('id'))->pluck('name')->toArray()
                                );
                            }
                        })
                        ->dehydrated(true)
                ])
                ->columnSpan(1)
                ->compact()
                ->collapsible();
        }

        return $schema
            ->components([
                Section::make(__('filament-modular-permissions::permissions.role_details.title'))
                    ->schema([
                        TextInput::make('name')
                            ->label(__('filament-modular-permissions::permissions.role_details.name_label'))
                            ->required()
                            ->maxLength(255)
                            ->unique(ignoreRecord: true)
                            ->disabled(fn (string $operation): bool => $operation === 'edit'),
                        TextInput::make('guard_name')
                            ->label(__('filament-modular-permissions::permissions.role_details.guard_label'))
                            ->default(fn () => Filament::getCurrentPanel()->getAuthGuard())
                            ->disabled()
                            ->dehydrated()
                            ->required(),
                    ])->columns(2)->columnSpanFull(),
                
                Section::make(__('filament-modular-permissions::permissions.permissions_section.title'))
                    ->columnSpanFull()
                    ->description(__('filament-modular-permissions::permissions.permissions_section.description'))
                    ->schema([
                        Grid::make(['default' => 1, 'md' => 2, 'xl' => 3])->schema($sections)
                    ]),
            ]);
    }

    /**
     * Resolve a human-readable label for a resource permission group.
     *
     * Resolution priority:
     *   1. Package lang file (filament-modular-permissions::permissions.resources.<key>)
     *   2. App config override (filament-modular-permissions.translations.resources.<key>)
     *   3. Active Filament Resource class getNavigationLabel() — searched across ALL registered panels
     *   4. Fallback: title-cased version of the permission key
     */
    protected static function resolveResourceLabel(string $resourceName): string
    {
        // 1. Try lang file
        $translated = __('filament-modular-permissions::permissions.resources.' . $resourceName);
        if ($translated !== 'filament-modular-permissions::permissions.resources.' . $resourceName) {
            return $translated;
        }

        // 2. Try config override
        $configOverride = config('filament-modular-permissions.translations.resources.' . $resourceName);
        if ($configOverride !== null) {
            return $configOverride;
        }

        // 3. Search across all registered Filament panel resources
        foreach (Filament::getPanels() as $panel) {
            foreach ($panel->getResources() as $resourceClass) {
                $snakeClass = Str::snake(class_basename($resourceClass));
                if ($snakeClass === $resourceName) {
                    try {
                        return $resourceClass::getNavigationLabel();
                    } catch (\Throwable) {
                        // Silently skip if the resource throws during static call
                    }
                }
            }
        }

        // 4. Title-case fallback
        return Str::title(str_replace('_', ' ', $resourceName));
    }

    /**
     * Resolve label for the widget group section.
     */
    protected static function translateWidget(string $groupKey): string
    {
        $override = config('filament-modular-permissions.translations.widgets.dashboard_widgets_label');
        if ($override) {
            return $override;
        }

        $translated = __('filament-modular-permissions::permissions.widgets.dashboard_widgets_label');
        if ($translated !== 'filament-modular-permissions::permissions.widgets.dashboard_widgets_label') {
            return $translated;
        }

        return 'Dashboard Widgets';
    }
}
