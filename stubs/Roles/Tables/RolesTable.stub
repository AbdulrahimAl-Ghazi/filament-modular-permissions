<?php

namespace {{namespace}}\Tables;

use Filament\Actions\DeleteAction;
use Filament\Actions\EditAction;
use Filament\Tables\Columns\TextColumn;
use Filament\Tables\Table;

class RolesTable
{
    public static function configure(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('name')
                    ->label(__('filament-modular-permissions::permissions.role_name'))
                    ->searchable(),
                TextColumn::make('guard_name')
                    ->label(__('filament-modular-permissions::permissions.guard_name'))
                    ->badge()
                    ->color('info'),
                TextColumn::make('permissions_count')
                    ->label(__('filament-modular-permissions::permissions.permissions_count'))
                    ->counts('permissions')
                    ->badge(),
            ])
            ->filters([
                //
            ])
            ->actions([
                EditAction::make()
                    ->hidden(fn ($record) => $record->name === 'super_admin'),
                DeleteAction::make()
                    ->hidden(fn ($record) => $record->name === 'super_admin'),
            ]);
    }
}
