<?php

namespace {{namespace}}\Tables;

use Filament\Actions\DeleteAction;
use Filament\Actions\EditAction;
use Filament\Tables\Columns\TextColumn;
use Filament\Tables\Table;

class UsersTable
{
    public static function configure(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('name')
                    ->label(__('filament-modular-permissions::permissions.user_table.name'))
                    ->searchable(),
                TextColumn::make('email')
                    ->label(__('filament-modular-permissions::permissions.user_table.email'))
                    ->searchable(),
                TextColumn::make('roles.name')
                    ->label(__('filament-modular-permissions::permissions.user_table.roles'))
                    ->badge()
                    ->color('info')
                    ->searchable(),
                TextColumn::make('created_at')
                    ->label(__('filament-modular-permissions::permissions.user_table.created_at'))
                    ->dateTime()
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: true),
            ])
            ->filters([
                //
            ])
            ->actions([
                EditAction::make(),
                DeleteAction::make(),
            ]);
    }
}
